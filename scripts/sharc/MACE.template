# SHARC 4 template for SHARC_MACE.py (X-MACE models)
model_file     /path/to/model.model        # several files (glob pattern) -> committee;
                                           # or give "modelpath <file>" in MACE.resources
properties     energy forces nacs socs     # add socs / dipoles if the model predicts them;
                                           # smooth_nacs passes NAC*dE instead of NACs
device         cpu                         # or cuda
energy_unit    eV                          # units the model was trained in (eV, Hartree)
distance_unit  Ang                         # Ang or Bohr
# soc_unit     cm-1                        # unit of the SOC labels if not energy_unit
                                           # (Hartree, eV, cm-1)
